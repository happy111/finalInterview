    "def rev(left,right,arr):\n",
    "    s = list(arr[left:right+1])\n",
    "    while left <= right:\n",
    "        \n",
    "def clockwise_shift(arr,k):\n",
    "    k = k % len(arr)\n",
    "    rev(0,k-1,arr)\n",
    "    return s\n",
    "\n",
    "arr = \"amazon\"\n",
    "k = 2\n",
    "shifted = clockwise_shift(arr, k)\n",
    "print(shifted)"
   ]
