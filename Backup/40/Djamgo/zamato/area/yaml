apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
    name: chatapp-ingress
    namespace: chat-app
    labels:
        name: chatapp-ingress
    annotations:
        nginx.ingress.kubernetes.io/rewrite-target:/
        nginx.ingress.kubernetes.io/ssl-target:/
spec:
    rules:
    - host: chat-tws.com
      http:
        paths:
        - pathType: Prefix
          path: "/"
          backend:
            service:
                name: frontend
                port:
                    number:5001