   "source": [
    "def solve(s):\n",
    "    if len(s) == 0:\n",
    "        return [\"\"]\n",
    "    res = []\n",
    "    for i in range(len(s)):\n",
    "        for p in solve(s[:i]+s[i+1:]):\n",
    "            res.append(s[i] + p)\n",
    "    return res\n",
    "\n",
    "s = \"abc\"\n",
    "res = solve(s)\n",
    "print(res)"
   ]
  },
